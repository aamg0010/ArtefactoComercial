# Integración con trygestión (fase 5). Sin URL y token la integración queda desactivada.
# URL de la API del tenant, p. ej. https://trygestion.com/gestion/api
TRYGESTION_URL=""
# Token de servicio "tgs_…" creado en trygestión para este tenant (no reutilizar el de Cronos).
TRYGESTION_TOKEN=""
# Opcional: mapa de etapas de la app → nombre de etapa del Pipeline de trygestión (JSON).
# Por defecto: {"DETECTED":"Prospecto","RESEARCHED":"Prospecto","CONTACTING":"Contacto inicial","MEETING":"Contacto inicial","PROPOSAL":"Propuesta enviada","NEGOTIATION":"Negociacion"}
TRYGESTION_STAGE_MAP=""
# "trygestion" envía los emails aprobados por el SMTP del tenant; vacío = solo copiar (comportamiento anterior).
EMAIL_TRANSPORT=""
# Enlaces entre sistemas. Web de trygestión (pantallas en la raíz) y dirección con la que se abre try! Comercial
# (se escribe en las notas de la empresa y en la oportunidad de trygestión; vacío = sin enlace).
TRYGESTION_WEB_URL="https://trygestion.com"
APP_PUBLIC_URL=""
# Acceso. "trygestion" (producción): cada persona entra con su usuario de trygestión y debe pertenecer al tenant.
# Vacío o "local": usuarios locales con contraseña (desarrollo y tests).
AUTH_MODE=""
TRYGESTION_TENANT_ID="tenant-try-legacy"
