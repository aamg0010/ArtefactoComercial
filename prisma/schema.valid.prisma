generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN SALES DIRECTOR }
enum Country { ES CO }
enum CompanyStatus { DETECTED RESEARCHED CONTACTING MEETING PROPOSAL NEGOTIATION WON LOST }
enum ContactSource { CSV GOOGLE_PLACES MANUAL WEB OTHER }
enum LegalBasis { LEGITIMATE_INTEREST CONSENT CONTRACT PENDING }
enum ConsentStatus { NOT_REQUIRED PENDING GRANTED WITHDRAWN }
enum OpportunityStatus { OPEN WON LOST }
enum ScriptChannel { CALL EMAIL FOLLOW_UP VOICEMAIL }
enum TaskType { CALL EMAIL FOLLOW_UP MEETING }
enum TaskStatus { PENDING COMPLETED SKIPPED CANCELLED }
enum ActivityType { CALL EMAIL NOTE MEETING }
enum SearchSource { GOOGLE_PLACES CSV APOLLO EINFORMA RUES LINKEDIN }

model User {
 id String @id @default(cuid())
 name String?
 email String @unique
 passwordHash String?
 role UserRole @default(SALES)
 timezone String @default("Europe/Madrid")
 accounts Account[]
 sessions Session[]
 assignedCompanies Company[] @relation("CompanyOwner")
 auditLogs AuditLog[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Account {
 id String @id @default(cuid())
 userId String
 type String
 provider String
 providerAccountId String
 refresh_token String? @db.Text
 access_token String? @db.Text
 expires_at Int?
 token_type String?
 scope String?
 id_token String? @db.Text
 session_state String?
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([provider, providerAccountId])
}
model Session { id String @id @default(cuid()) sessionToken String @unique userId String expires DateTime user User @relation(fields: [userId], references: [id], onDelete: Cascade) }
model VerificationToken { identifier String token String @unique expires DateTime @@unique([identifier, token]) }
model Company {
 id String @id @default(cuid())
 name String
 normalizedName String
 fictional Boolean @default(false)
 nifNit String? @unique
 website String?
 normalizedDomain String?
 email String?
 phone String?
 country Country
 region String?
 city String?
 sector String?
 employeeRange String?
 source ContactSource @default(MANUAL)
 sourceDetail String?
 status CompanyStatus @default(DETECTED)
 ownerId String?
 owner User? @relation("CompanyOwner", fields: [ownerId], references: [id])
 contacts Contact[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([normalizedName, country])
 @@index([normalizedDomain])
}
model Contact {
 id String @id @default(cuid())
 companyId String
 firstName String?
 lastName String?
 fullName String
 role String?
 email String?
 phone String?
 source ContactSource @default(MANUAL)
 sourceDetail String?
 legalBasis LegalBasis @default(PENDING)
 consentStatus ConsentStatus @default(PENDING)
 requiresConsent Boolean @default(false)
 company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([companyId])
}
model Product { id String @id @default(cuid()) name String @unique description String line String @unique active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ResearchReport { id String @id @default(cuid()) companyId String summary String? sources Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Score { id String @id @default(cuid()) companyId String total Int classification String weights Json? createdAt DateTime @default(now()) }
model Opportunity { id String @id @default(cuid()) companyId String productId String status OpportunityStatus @default(OPEN) createdAt DateTime @default(now()) }
model Script { id String @id @default(cuid()) companyId String productLine String channel ScriptChannel version Int @default(1) content String citations Json? createdAt DateTime @default(now()) @@unique([companyId, productLine, channel, version]) }
model Template { id String @id @default(cuid()) name String channel ScriptChannel content String active Boolean @default(true) createdAt DateTime @default(now()) }
model Cadence { id String @id @default(cuid()) name String active Boolean @default(true) createdAt DateTime @default(now()) }
model CadenceStep { id String @id @default(cuid()) cadenceId String dayOffset Int taskType TaskType templateId String? @@unique([cadenceId, dayOffset, taskType]) }
model Task { id String @id @default(cuid()) companyId String assigneeId String? type TaskType status TaskStatus @default(PENDING) dueAt DateTime createdAt DateTime @default(now()) }
model Activity { id String @id @default(cuid()) companyId String authorId String? type ActivityType body String? occurredAt DateTime @default(now()) }
model SearchProfile { id String @id @default(cuid()) name String active Boolean @default(true) country Country region String? sectorCode String? keywords String[] createdAt DateTime @default(now()) }
model SourceRun { id String @id @default(cuid()) profileId String? source SearchSource startedAt DateTime @default(now()) finishedAt DateTime? discovered Int @default(0) created Int @default(0) duplicates Int @default(0) error String? }
model ConsentRecord { id String @id @default(cuid()) contactId String status ConsentStatus basis LegalBasis capturedAt DateTime @default(now()) proof String? }
model SuppressionList { id String @id @default(cuid()) email String? @unique phone String? @unique domain String? @unique reason String createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String? entityType String entityId String action String metadata Json? createdAt DateTime @default(now()) user User? @relation(fields: [userId], references: [id]) @@index([entityType, entityId]) }
