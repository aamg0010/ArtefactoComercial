generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
  DIRECTOR
}
enum Country {
  ES
  CO
}
enum ContactSource {
  CSV
  GOOGLE_PLACES
  MANUAL
  WEB
  OTHER
}
enum LegalBasis {
  LEGITIMATE_INTEREST
  CONSENT
  CONTRACT
  PENDING
}
enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  GRANTED
  WITHDRAWN
}
enum TaskType {
  CALL
  EMAIL
  FOLLOW_UP
}
enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
  CANCELLED
}
enum ActivityType {
  CALL
  EMAIL
  NOTE
  MEETING
}
enum CompanyCadenceStatus {
  ACTIVE
  PAUSED
  FINISHED
}
enum ScriptStatus {
  BORRADOR
  APPROVED
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  passwordHash String?
  role UserRole @default(SALES)
  accounts Account[]
  sessions Session[]
  assignedCompanies Company[] @relation("CompanyOwner")
  auditLogs AuditLog[]
  tasks Task[] @relation("TaskAssignee")
  activities Activity[] @relation("ActivityAuthor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Company {
  id String @id @default(cuid())
  sourceId String? @unique
  name String
  normalizedName String
  fictional Boolean @default(false)
  nifNit String? @unique
  website String?
  normalizedDomain String?
  email String?
  phone String?
  country Country
  region String?
  comarca String?
  city String?
  sector String?
  employeeRange String?
  source ContactSource @default(MANUAL)
  sourceDetail String?
  priority String?
  pipelineStage String @default("DETECTED")
  nextAction String?
  nextActionAt DateTime?
  ownerId String?
  owner User? @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts Contact[]
  researchReports ResearchReport[]
  opportunities Opportunity[]
  scripts Script[]
  tasks Task[]
  activities Activity[]
  cadences CompanyCadence[]
  suppressions SuppressionList[]
  scores Score[]
  aiRuns AiRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([normalizedName, country])
  @@index([normalizedDomain])
}
model Contact {
  id String @id @default(cuid())
  companyId String
  fullName String
  role String?
  email String?
  phone String?
  source ContactSource @default(MANUAL)
  sourceDetail String?
  legalBasis LegalBasis @default(PENDING)
  consentStatus ConsentStatus @default(PENDING)
  requiresConsent Boolean @default(false)
  verified Boolean @default(false)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
}
model Product {
  id String @id @default(cuid())
  name String @unique
  description String
  line String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  opportunities Opportunity[]
}
model ResearchReport {
  id String @id @default(cuid())
  companyId String
  summary String?
  sourceUrl String?
  data Json?
  version Int @default(1)
  origin String @default("SEED")
  score Score?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, version])
}
model Opportunity {
  id String @id @default(cuid())
  companyId String
  productId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  @@unique([companyId, productId])
}
model Script {
  id String @id @default(cuid())
  companyId String
  version Int @default(1)
  author String
  content Json
  status ScriptStatus @default(APPROVED)
  approvedAt DateTime?
  approvedBy String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks Task[]
  companyCadences CompanyCadence[]
  createdAt DateTime @default(now())
  @@unique([companyId, version])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  entityType String
  entityId String
  action String
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
}

model Cadence {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  steps CadenceStep[]
  companyCadences CompanyCadence[]
}
model CadenceStep {
  id String @id @default(cuid())
  cadenceId String
  dayOffset Int
  type TaskType
  action String
  createdAt DateTime @default(now())
  cadence Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  tasks Task[]
  @@unique([cadenceId, dayOffset, type])
}
model Task {
  id String @id @default(cuid())
  companyId String
  companyCadenceId String?
  cadenceStepId String?
  assigneeId String?
  type TaskType
  title String
  scriptId String?
  status TaskStatus @default(PENDING)
  dueAt DateTime?
  completedAt DateTime?
  result String?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyCadence CompanyCadence? @relation(fields: [companyCadenceId], references: [id], onDelete: Cascade)
  cadenceStep CadenceStep? @relation(fields: [cadenceStepId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  script Script? @relation(fields: [scriptId], references: [id])
  activities Activity[]
  @@index([companyId, dueAt, status])
  @@unique([companyId, cadenceStepId])
}
model Activity {
  id String @id @default(cuid())
  companyId String
  taskId String?
  authorId String?
  type ActivityType
  result String?
  body String?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author User? @relation("ActivityAuthor", fields: [authorId], references: [id])
}
model CompanyCadence {
  id String @id @default(cuid())
  companyId String
  cadenceId String
  scriptId String?
  startDate DateTime
  status CompanyCadenceStatus @default(ACTIVE)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cadence Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  script Script? @relation(fields: [scriptId], references: [id])
  tasks Task[]
  @@unique([companyId, cadenceId])
}
model SuppressionList {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  companyId String?
  reason String
  createdAt DateTime @default(now())
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model AiRun {
  id String @id @default(cuid())
  companyId String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider String
  model String
  purpose String
  durationMs Int
  inputTokens Int?
  outputTokens Int?
  success Boolean
  error String?
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}

model ScoringWeights {
  id String @id @default("default")
  sector Int @default(25)
  size Int @default(15)
  intent Int @default(20)
  contact Int @default(15)
  proximity Int @default(15)
  crossSell Int @default(10)
  updatedAt DateTime @updatedAt
}

model Score {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  researchReportId String @unique
  researchReport ResearchReport @relation(fields: [researchReportId], references: [id], onDelete: Cascade)
  total Int
  suggestedPriority String
  breakdown Json
  createdAt DateTime @default(now())
}

model Template {
  id String @id @default(cuid())
  name String @unique
  content Json
  updatedAt DateTime @updatedAt
}
